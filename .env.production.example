# VPS production sablonu.
# Bu dosyayi .env.production olarak kopyalayin ve tum CHANGE_ME degerlerini doldurun.
# Gercek .env.production dosyasini git'e koymayin.

# MUTLAKA degistir: guclu, rastgele ve bu projeye ozel degerler kullanin.
# Faz 0 schema/hardening bootstrap rolu. Runtime craftora_app gecisi sonraki fazdir.
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=CraftoraMobile

MINIO_ROOT_USER=CHANGE_ME_STRONG_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_ROOT_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
RABBITMQ_DEFAULT_USER=CHANGE_ME_STRONG_RABBITMQ_USER
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG_RABBITMQ_PASSWORD

# MUTLAKA yeni production JWT secret uretin: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET

# Production domain/secret degerleri. Test Google/Stripe anahtari kullanmayin.
GOOGLE_CLIENT_ID=CHANGE_ME_PRODUCTION_GOOGLE_CLIENT_ID
# Web ve Android OAuth Client ID'lerini virgülle ayırarak yazın.
GOOGLE_CLIENT_IDS=CHANGE_ME_WEB_GOOGLE_CLIENT_ID,CHANGE_ME_ANDROID_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_PRODUCTION_GOOGLE_CLIENT_SECRET
RESEND_API_KEY=CHANGE_ME_PRODUCTION_RESEND_API_KEY
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@craftora.com
EMAIL_FROM_NAME=Craftora
STRIPE_SECRET_KEY=CHANGE_ME_PRODUCTION_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=CHANGE_ME_PRODUCTION_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_PRODUCTION_STRIPE_WEBHOOK_SECRET
SENTRY_DSN=CHANGE_ME_PRODUCTION_SENTRY_DSN

# Container ici baglanti: sabit kalir; host IP/localhost yazmayin.
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_USE_SSL=false

# Local 192.168.x.x yerine public storage domain kullanin.
# SSL adimi tamamlanana kadar false ancak public HTTP proxy hazir olmadan kullanilamaz.
MINIO_PUBLIC_ENDPOINT=storage.craftora.com
MINIO_PUBLIC_USE_SSL=true
STORAGE_PUBLIC_SERVICE_URL=https://storage.craftora.com

# Production web originleri; localhost/192.168.x.x kullanmayin.
CORS_ORIGIN_0=https://craftora.com
CORS_ORIGIN_1=https://app.craftora.com

# Elasticsearch: Faz 0'da 9200 host'a kapali oldugu icin false calisabilir.
# Auth'i true yapacaksaniz client credentials ayarini da ayni deploy'da ekleyin.
ELASTICSEARCH_SECURITY_ENABLED=false
FIREBASE_PROJECT_ID=craftora-1ff03
